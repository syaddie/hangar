{
  "name": "hangar",
  "productName": "Hangar",
  "version": "0.1.0",
  "private": true,
  "description": "One desktop window for Apogee, Launchpad and the apps that come after them.",
  "author": "syaddie",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "smoke": "node scripts/build.mjs && node scripts/smoke.mjs",
    "dist": "node scripts/build.mjs && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "com.syaddie.hangar",
    "productName": "Hangar",
    "copyright": "Syaddie",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Hangar",
      "artifactName": "Hangar-Setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
